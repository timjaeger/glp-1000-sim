{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftrwrlds.com/glp-1000/world_state.schema.json",
  "title": "GLP-1000 world state",
  "type": "object",
  "additionalProperties": false,
  "required": ["year", "fictional", "population", "access", "drugs", "safety_ledger", "economy", "body_and_culture", "interior_life", "state", "events", "open_tensions"],
  "properties": {
    "year": {"type": "integer", "minimum": 2026, "maximum": 2040},
    "fictional": {"type": "boolean", "description": "false only for the researched step-0 baseline"},

    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["us_adults_on_drug_pct", "us_adults_ever_used_pct", "by_income_third_pct", "by_age_band_pct", "pediatric_under_18_on_drug_pct", "cycled_off_and_on_pct", "note"],
      "properties": {
        "us_adults_on_drug_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "us_adults_ever_used_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "by_income_third_pct": {"type": "object", "additionalProperties": false, "required": ["top", "middle", "bottom"],
          "properties": {"top": {"type": ["number", "null"]}, "middle": {"type": ["number", "null"]}, "bottom": {"type": ["number", "null"]}}},
        "by_age_band_pct": {"type": "object", "additionalProperties": false, "required": ["18_29", "30_49", "50_64", "65_plus"],
          "properties": {"18_29": {"type": ["number", "null"]}, "30_49": {"type": ["number", "null"]}, "50_64": {"type": ["number", "null"]}, "65_plus": {"type": ["number", "null"]}}},
        "pediatric_under_18_on_drug_pct": {"type": ["number", "null"]},
        "cycled_off_and_on_pct": {"type": ["number", "null"], "description": "share of ever-users who have stopped at least once and restarted"},
        "note": {"type": "string"}
      }
    },

    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["cash_price_usd_month_low", "cash_price_usd_month_high", "public_coverage", "employer_coverage_pct", "generic_us", "generic_rest_of_world", "gray_market", "dominant_route", "note"],
      "properties": {
        "cash_price_usd_month_low": {"type": "number", "minimum": 0},
        "cash_price_usd_month_high": {"type": "number", "minimum": 0},
        "public_coverage": {"type": "string"},
        "employer_coverage_pct": {"type": ["number", "null"], "description": "share of employers covering for weight management"},
        "generic_us": {"type": "boolean"},
        "generic_rest_of_world": {"type": "string"},
        "gray_market": {"type": "string", "enum": ["negligible", "contained", "significant", "dominant"]},
        "dominant_route": {"type": "string", "enum": ["weekly_injectable", "daily_oral", "mixed", "monthly_or_implant"]},
        "note": {"type": "string"}
      }
    },

    "drugs": {
      "type": "object", "additionalProperties": false,
      "required": ["on_market_classes", "best_efficacy_pct_body_weight", "indications_beyond_weight_and_diabetes", "mainstream_offlabel_uses", "pipeline_note"],
      "properties": {
        "on_market_classes": {"type": "array", "items": {"type": "string"}},
        "best_efficacy_pct_body_weight": {"type": "number", "minimum": 0, "maximum": 60},
        "indications_beyond_weight_and_diabetes": {"type": "array", "items": {"type": "string"}},
        "mainstream_offlabel_uses": {"type": "array", "items": {"type": "string"}},
        "pipeline_note": {"type": "string"}
      }
    },

    "safety_ledger": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["effect", "status", "prevalence_note", "regulatory_response"],
        "properties": {
          "effect": {"type": "string"},
          "status": {"type": "string", "enum": ["established", "suspected", "emerging", "debunked"]},
          "prevalence_note": {"type": "string"},
          "regulatory_response": {"type": "string"}
        }
      }
    },

    "economy": {
      "type": "object", "additionalProperties": false,
      "required": ["food_and_beverage", "alcohol", "restaurants", "apparel", "fitness", "insurance", "pharma", "severity"],
      "properties": {
        "food_and_beverage": {"$ref": "#/$defs/sector"},
        "alcohol": {"$ref": "#/$defs/sector"},
        "restaurants": {"$ref": "#/$defs/sector"},
        "apparel": {"$ref": "#/$defs/sector"},
        "fitness": {"$ref": "#/$defs/sector"},
        "insurance": {"$ref": "#/$defs/sector"},
        "pharma": {"$ref": "#/$defs/sector"},
        "severity": {"type": "integer", "minimum": 1, "maximum": 10, "description": "generator's own 1–10 read of economic harm to ordinary people; the judge re-scores"}
      }
    },

    "body_and_culture": {
      "type": "object", "additionalProperties": false,
      "required": ["what_the_body_signals", "thinness_and_class", "eating_as_ritual", "dating_and_intimacy", "meaning_of_appetite", "severity"],
      "properties": {
        "what_the_body_signals": {"type": "string"},
        "thinness_and_class": {"type": "string"},
        "eating_as_ritual": {"type": "string"},
        "dating_and_intimacy": {"type": "string"},
        "meaning_of_appetite": {"type": "string"},
        "severity": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },

    "interior_life": {
      "type": "object", "additionalProperties": false,
      "required": ["personality_layer", "reward_blunting_prevalence_note", "framing", "effect_on_work", "effect_on_art_and_play", "effect_on_intimacy", "effect_on_politics", "severity"],
      "properties": {
        "personality_layer": {"type": "string", "enum": ["unrecognised", "niche_side_effect", "mainstream_complaint", "marketed_feature", "employer_encouraged"]},
        "reward_blunting_prevalence_note": {"type": "string"},
        "framing": {"type": "string", "description": "how society names it: side effect / feature / treatment / character"},
        "effect_on_work": {"type": "string"},
        "effect_on_art_and_play": {"type": "string"},
        "effect_on_intimacy": {"type": "string"},
        "effect_on_politics": {"type": "string"},
        "severity": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },

    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["regulatory_posture", "subsidy_or_mandate", "conditioning_or_surveillance", "workforce_or_military", "geopolitics_of_supply", "severity"],
      "properties": {
        "regulatory_posture": {"type": "string"},
        "subsidy_or_mandate": {"type": "string"},
        "conditioning_or_surveillance": {"type": "string"},
        "workforce_or_military": {"type": "string"},
        "geopolitics_of_supply": {"type": "string"},
        "severity": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },

    "events": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "event", "driver"],
        "properties": {
          "date": {"type": "string", "description": "YYYY-MM"},
          "event": {"type": "string"},
          "driver": {"type": "string", "description": "which drawn driver this event realises, or 'baseline'"}
        }
      }
    },

    "open_tensions": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": {"type": "string"}
    }
  },

  "$defs": {
    "sector": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "direction"],
      "properties": {
        "state": {"type": "string"},
        "direction": {"type": "string", "enum": ["collapsing", "contracting", "adapted", "growing"]}
      }
    }
  }
}
