{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftrwrlds.com/glp-1000/run.schema.json",
  "title": "GLP-1000 simulation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "step", "year", "parent_lineage", "seed", "drivers", "status", "generator_model", "created_at"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^s[1-5]-L[0-9]+-r[0-9]{2}$", "description": "e.g. s2-L1-r07"},
    "step": {"type": "integer", "minimum": 1, "maximum": 5},
    "year": {"type": "integer"},
    "parent_lineage": {"type": "string", "description": "L0 for step 1 (the baseline), else the parent's lineage id"},
    "seed": {"type": "integer", "description": "base seed; this run's RNG is random.Random(seed + step*1000 + run_index)"},
    "run_index": {"type": "integer", "minimum": 0, "description": "index of the run within its step (the rNN of run_id)"},
    "driver_modifiers": {
      "type": "array",
      "description": "parent-state modifiers from config/drivers.json that fired for this run's draw",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["driver", "if", "set"],
        "properties": {"driver": {"type": "string"}, "if": {"type": "object"}, "set": {"type": "object"}}
      }
    },
    "drivers": {
      "type": "object", "additionalProperties": false,
      "required": ["adoption_delta_pp", "price_path", "coverage_shift", "new_indications", "safety_signal", "next_gen_launch", "market_shock", "cultural_response", "state_action", "personality_layer"],
      "properties": {
        "adoption_delta_pp": {"type": "number"},
        "price_path": {"type": "string"},
        "coverage_shift": {"type": "string"},
        "new_indications": {"type": "array", "items": {"type": "string"}, "maxItems": 2},
        "safety_signal": {"type": "string"},
        "next_gen_launch": {"type": "string"},
        "market_shock": {"type": "string"},
        "cultural_response": {"type": "string"},
        "state_action": {"type": "string"},
        "personality_layer": {"type": "string"}
      }
    },
    "status": {"type": "string", "enum": ["pending", "ok", "invalid", "error"]},
    "generator_model": {"type": "string"},
    "created_at": {"type": "string"},
    "world": {"$ref": "world_state.schema.json"},
    "prose": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "world_in_600_words", "a_day_in_the_life"],
      "properties": {
        "headline": {"type": "string", "maxLength": 140},
        "world_in_600_words": {"type": "string"},
        "a_day_in_the_life": {"type": "string", "description": "one ordinary person, one ordinary day, ~250 words; the film lives here"}
      }
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["judge_model", "badness", "plausibility", "generativity", "rationale"],
      "properties": {
        "judge_model": {"type": "string"},
        "rubric": {"type": "string", "description": "judge rubric version; absent means v1 (one plausibility score)"},
        "least_plausible_claims": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "description": "rubric v2: the judge's three least plausible specific claims, each quoted verbatim from the candidate",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["quote", "field", "why"],
            "properties": {
              "quote": {"type": "string", "minLength": 1, "maxLength": 300},
              "field": {"type": "string"},
              "why": {"type": "string"}
            }
          }
        },
        "badness": {
          "type": "object", "additionalProperties": false,
          "required": ["flourishing", "autonomy", "inequality", "public_health", "cohesion", "epistemic", "overall"],
          "properties": {
            "flourishing": {"type": "number", "minimum": 1, "maximum": 10},
            "autonomy": {"type": "number", "minimum": 1, "maximum": 10},
            "inequality": {"type": "number", "minimum": 1, "maximum": 10},
            "public_health": {"type": "number", "minimum": 1, "maximum": 10},
            "cohesion": {"type": "number", "minimum": 1, "maximum": 10},
            "epistemic": {"type": "number", "minimum": 1, "maximum": 10},
            "overall": {"type": "number", "minimum": 1, "maximum": 10}
          }
        },
        "plausibility_axes": {
          "type": "object", "additionalProperties": false,
          "description": "rubric v2: plausibility sub-axes, scored separately; `plausibility` is their weighted composite (config plausibility_weights)",
          "required": ["driver_fidelity", "mechanism", "magnitude"],
          "properties": {
            "driver_fidelity": {"type": "number", "minimum": 1, "maximum": 10},
            "mechanism": {"type": "number", "minimum": 1, "maximum": 10},
            "magnitude": {"type": "number", "minimum": 1, "maximum": 10}
          }
        },
        "plausibility_weights": {
          "type": "object", "additionalProperties": false,
          "description": "the weights the composite was computed with (config plausibility_weights at judging time)",
          "required": ["driver_fidelity", "mechanism", "magnitude"],
          "properties": {
            "driver_fidelity": {"type": "number"}, "mechanism": {"type": "number"}, "magnitude": {"type": "number"}
          }
        },
        "plausibility": {"type": "number", "minimum": 1, "maximum": 10,
                         "description": "v2: weighted composite of plausibility_axes (config plausibility_weights), computed in code; v1: the judge's single score"},
        "generativity": {"type": "number", "minimum": 1, "maximum": 10},
        "rationale": {
          "type": "object",
          "required": ["badness", "plausibility", "generativity"],
          "properties": {
            "badness": {"type": "string"},
            "plausibility": {"type": "string"},
            "generativity": {"type": "string"}
          }
        }
      }
    },
    "error": {"type": "string", "description": "why a run has status error (API error, refusal, expiry)"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "description": "every API call made for this run",
      "properties": {
        "generation": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "judge": {"type": "array", "items": {"$ref": "#/$defs/call"}}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "description": "local schema check of the model's output, kept so invalid runs are never silently dropped",
      "properties": {
        "generation": {"$ref": "#/$defs/validation_record"},
        "judge": {"$ref": "#/$defs/validation_record"}
      }
    },
    "superseded_scores": {
      "type": "array",
      "description": "earlier `scores` replaced by a re-judge (e.g. under a revised rubric), oldest first, each with superseded_at",
      "items": {"type": "object", "required": ["superseded_at"]}
    },
    "judge_samples": {
      "type": "array",
      "description": "individual judge responses when judging.judge_samples > 1; `scores` holds their mean",
      "items": {"type": "object"}
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "axis": {"type": "string"},
        "axis_badness": {"type": "number"},
        "rank": {"type": "integer"},
        "survived": {"type": "boolean"},
        "new_lineage": {"type": ["string", "null"]},
        "floor_used": {"type": "integer"}
      }
    }
  },

  "$defs": {
    "call": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "batch_id", "custom_id", "model", "result_type"],
      "properties": {
        "role": {"type": "string", "enum": ["main", "repair"]},
        "batch_id": {"type": "string"},
        "custom_id": {"type": "string"},
        "model": {"type": "string", "description": "model requested (from config)"},
        "served_model": {"type": ["string", "null"], "description": "model the API reports it ran"},
        "result_type": {"type": "string", "description": "succeeded / errored / canceled / expired"},
        "stop_reason": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]}
      }
    },
    "validation_record": {
      "type": "object", "additionalProperties": false,
      "required": ["errors", "repair_attempted"],
      "properties": {
        "errors": {"type": "array", "items": {"type": "string"}, "description": "errors in the last response checked; empty if it passed"},
        "first_errors": {"type": "array", "items": {"type": "string"}, "description": "errors in the original response, kept after a repair"},
        "raw_output": {"type": ["string", "null"], "description": "the failing response text (null once a run is valid)"},
        "repair_attempted": {"type": "boolean"},
        "repaired": {"type": "boolean"}
      }
    }
  }
}
