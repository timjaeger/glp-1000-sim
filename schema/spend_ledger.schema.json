{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftrwrlds.com/glp-1000/spend_ledger.schema.json",
  "title": "GLP-1000 spend ledger (runs/spend_ledger.json)",
  "description": "Every Message Batch ever submitted, across all steps and attempts. It lives outside runs/stepN/, so clearing a failed attempt's files never drops its spend; the cost guardrail sums it per step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batches"],
  "properties": {
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kind", "role", "batch_id", "model", "submitted_at", "request_count", "estimate_usd", "status"],
        "properties": {
          "step": {"type": "integer", "minimum": 1, "maximum": 5},
          "kind": {"type": "string", "enum": ["generate", "judge"]},
          "role": {"type": "string", "enum": ["main", "repair"]},
          "batch_id": {"type": "string"},
          "model": {"type": "string"},
          "submitted_at": {"type": "string"},
          "collected_at": {"type": ["string", "null"]},
          "request_count": {"type": "integer"},
          "estimate_usd": {"type": "number", "description": "worst-case estimate printed before submitting"},
          "status": {"type": "string", "enum": ["submitted", "collected"]},
          "input_tokens": {"type": ["integer", "null"]},
          "output_tokens": {"type": ["integer", "null"]},
          "actual_usd": {"type": ["number", "null"], "description": "from the usage the API reported, at config batch prices"},
          "result_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
          "note": {"type": "string", "description": "e.g. which attempt, and where its run files are kept if they were cleared"}
        }
      }
    }
  }
}
